# Copie para .env na raiz: cp .env.example .env
#
# Docker: na pasta do repositório rode `docker compose up -d`
# - API: http://localhost:8000  (Swagger em /docs)
# - Frontend (nginx): http://localhost:8080
# O Postgres e o Redis não são expostos no host (só rede interna do Compose).

# --- Autenticação / JWT ---
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Banco de dados (API + Alembic dentro do Docker) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cidade_idoso

# --- Cache (Redis) ---
# Dentro do Docker use o serviço "redis". Vazio = cache desabilitado.
REDIS_URL=redis://redis:6379/0

# --- Frontend (para montar o link no e-mail de redefinição de senha) ---
FRONTEND_BASE_URL=http://localhost:3000

# --- E-mail / SMTP (recuperação de senha) ---
# Preencha para envio real. Ex.: Gmail (use uma "senha de app"),
# Mailtrap, SendGrid SMTP, etc. Vazio = envio apenas registrado em log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responder@cidadeidoso.local
MAIL_FROM_NAME=Portal Cidade do Idoso
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
